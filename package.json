{
  "name": "wp-parsidate",
  "description": "ParsiDate Assets",
  "version": "1.0.0",
  "homepage": "https://parsa.ws",
  "author": "Parsa Kafi (https://parsa.ws)",
  "scripts": {
    "parsidate-plugin-css": "sass --watch assets/scss/plugin.scss:assets/css-admin/plugin.css",
    "parsidate-plugin-compressed-css": "sass --watch assets/scss/plugin.scss:assets/css-admin/plugin.min.css --style compressed",
    "parsidate-admin-css": "sass --watch assets/scss/admin.scss:assets/css-admin/admin.css",
    "parsidate-admin-compressed-css": "sass --watch assets/scss/admin.scss:assets/css-admin/admin.min.css --style compressed",
    "parsidate-vazir-font-css": "sass --watch assets/scss/vazir-font.scss:assets/css-admin/vazir-font.css",
    "parsidate-vazir-font-compressed-css": "sass --watch assets/scss/vazir-font.scss:assets/css-admin/vazir-font.min.css --style compressed",
    "parsidate-dashboard-css": "sass --watch assets/scss/dashboard.scss:assets/css-admin/dashboard.css",
    "parsidate-dashboard-compressed-css": "sass --watch assets/scss/dashboard.scss:assets/css-admin/dashboard.min.css --style compressed",
    "parsidate-woocommerce-css": "sass --watch assets/scss/woocommerce.scss:assets/css-admin/woocommerce.css",
    "parsidate-woocommerce-compressed-css": "sass --watch assets/scss/woocommerce.scss:assets/css-admin/woocommerce.min.css --style compressed",
    "parsidate-build-js": "webpack --config webpack.config.js"
  },
  "devDependencies": {
    "extract-loader": "^4.0.3",
    "sass": "^1.85.1",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.5.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^6.0.1"
  }
}
